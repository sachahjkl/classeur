package classeur

// The filled icons of Phosphor (phosphoricons.com, MIT: assets/fonts/PHOSPHOR-LICENSE.txt), its "fill" weight as a font:
// what stands for a file or a place is a solid shape in a colour, as File Pilot draws them; the thin Lucide icons stay
// for the buttons of the bars. Each constant is an icon's character in the font, named as Phosphor names it.

PHOSPHOR_DATA :: #load("../assets/fonts/phosphor-fill.ttf")

PH_APP_WINDOW      :: ""   // app-window
PH_ARCHIVE         :: ""   // archive
PH_BOOKMARK_SIMPLE :: ""   // bookmark-simple
PH_CLOCK_BACK      :: ""   // clock-counter-clockwise
PH_DESKTOP         :: ""   // desktop
PH_DOWNLOAD_SIMPLE :: ""   // download-simple
PH_FILE_AUDIO      :: ""   // file-audio
PH_FILE_CODE       :: ""   // file-code
PH_FILE_CSS        :: ""   // file-css
PH_FILE_CSV        :: ""   // file-csv
PH_FILE_DOC        :: ""   // file-doc
PH_FILE_HTML       :: ""   // file-html
PH_FILE_IMAGE      :: ""   // file-image
PH_FILE_JS         :: ""   // file-js
PH_FILE_MD         :: ""   // file-md
PH_FILE_PDF        :: ""   // file-pdf
PH_FILE_PY         :: ""   // file-py
PH_FILE_RS         :: ""   // file-rs
PH_FILE_SQL        :: ""   // file-sql
PH_FILE_TEXT       :: ""   // file-text
PH_FILE_TS         :: ""   // file-ts
PH_FILE_TXT        :: ""   // file-txt
PH_FILE_VIDEO      :: ""   // file-video
PH_FILE_XLS        :: ""   // file-xls
PH_FILE_ZIP        :: ""   // file-zip
PH_FILM_STRIP      :: ""   // film-strip
PH_FOLDER          :: ""   // folder
PH_HARD_DRIVE      :: ""   // hard-drive
PH_HARD_DRIVES     :: ""   // hard-drives
PH_HOUSE           :: ""   // house
PH_IMAGE           :: ""   // image
PH_MUSIC_NOTES     :: ""   // music-notes
PH_PACKAGE         :: ""   // package
PH_TERMINAL_WINDOW :: ""   // terminal-window
PH_TRASH           :: ""   // trash
PH_USB             :: ""   // usb
